# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Discord application client ID
DISCORD_CLIENT_ID=

# Discord server (guild) ID where slash commands are registered
DISCORD_GUILD_ID=

# Comma-separated list of text channel IDs where Bounty Rune can spawn
BOUNTY_CHANNEL_IDS=

# Supabase project URL and service role key (for server-side DB access)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Average number of Bounty Rune spawns per week (float allowed, e.g. 1.5)
BOUNTY_AVG_PER_WEEK=1

# Gold reward amount per claimed Bounty Rune
BOUNTY_GOLD_REWARD=50

# How long (in ms) the ephemeral confirmation message persists before auto-deletion
BOUNTY_CLAIM_TIMEOUT_MS=30000

# Optional: Discord channel ID for scheduler error notifications
ADMIN_LOG_CHANNEL_ID=

# Optional: maximum gold that can be added/removed per /add or /remove command
MAX_GOLD_ADJUSTMENT=100000

# Optional: gold stake per player in /duel (default: 50)
BOUNTY_DUEL_STAKE=50

# Optional: entry fee per player in /roshan, paid when the fight starts and never refunded
BOUNTY_ROSHAN_ENTRY=50
# Optional: gold reward/penalty in /roshan (default: 660; each player gets ceil(pool / party size))
BOUNTY_ROSHAN_GOLD=660
# Optional: win chance in percent (0-100) by party size in /roshan
BOUNTY_ROSHAN_CHANCE_3=20
BOUNTY_ROSHAN_CHANCE_4=28
BOUNTY_ROSHAN_CHANCE_5=38
# Optional: chance in percent that one random player dies after a WON Roshan fight
# (the dead player gets no reward, the pool is split among survivors; 0 disables)
BOUNTY_ROSHAN_DEATH_CHANCE=5
# Optional: minutes before an unfilled /roshan lobby expires (default: 10)
BOUNTY_ROSHAN_LOBBY_TIMEOUT_MIN=10

# NOTE: the gold/chance/timeout values above are only starting defaults.
# Admins can override them live from Discord (/bounty_gold_reward, /roshan_gold, ...).

# Optional: /give limit — one transfer per this many days per user (default: 7, 0 = no limit)
BOUNTY_GIVE_COOLDOWN_DAYS=7
