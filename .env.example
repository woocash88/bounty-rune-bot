# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Discord application client ID
DISCORD_CLIENT_ID=

# Discord server (guild) ID where slash commands are registered
DISCORD_GUILD_ID=

# Comma-separated list of text channel IDs where Bounty Rune can spawn
BOUNTY_CHANNEL_IDS=

# Supabase project URL and service role key (for server-side DB access)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Average number of Bounty Rune spawns per week (float allowed, e.g. 1.5)
BOUNTY_AVG_PER_WEEK=1

# Gold reward amount per claimed Bounty Rune
BOUNTY_GOLD_REWARD=50

# How long (in ms) the ephemeral confirmation message persists before auto-deletion
BOUNTY_CLAIM_TIMEOUT_MS=30000

# Optional: Discord channel ID for scheduler error notifications
ADMIN_LOG_CHANNEL_ID=

# Optional: maximum gold that can be added/removed per /add or /remove command
MAX_GOLD_ADJUSTMENT=100000

# Optional: gold stake per player in /duel (default: 50)
BOUNTY_DUEL_STAKE=50
